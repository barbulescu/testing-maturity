<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.barbulescu.testability.examples</groupId>
    <artifactId>maven-java17-pitest</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <!-- Runs the tests again in minion JVMs of its own: once to see what they
                     cover, then against each mutant of Discount. -->
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.2</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>ch.barbulescu.testability.examples.pitest.*</targetClasses>
                    <threads>1</threads>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activated by the harness for the "probe" run; a baseline run leaves this
             project entirely unmodified. -->
        <profile>
            <id>testability-probe</id>
            <activation>
                <property>
                    <name>testability.probe.repo</name>
                </property>
            </activation>
            <repositories>
                <repository>
                    <id>testability-probe-repo</id>
                    <url>${testability.probe.repo}</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>${testability.probe.groupId}</groupId>
                    <artifactId>${testability.probe.artifactId}</artifactId>
                    <version>${testability.probe.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
